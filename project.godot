; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Studio Tycoon"
config/features=PackedStringArray("4.7")
run/main_scene="res://src/ui/main.tscn"

[autoload]

EventBus="*res://src/core/event_bus.gd"
GameRunner="*res://src/core/game_runner.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings.th.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
